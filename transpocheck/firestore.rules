rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. EL CANDADO MAESTRO: Verificamos los correos desde el servidor seguro de Google
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.email == 'fcastro@logisticats.cl' || 
              request.auth.token.email == 'hcastro@logisticats.cl');
    }

    // Función básica para saber si cualquier usuario está logueado en la app (Equipo interno)
    function isLogged() {
      return request.auth != null;
    }

    // -----------------------------------------------------------------------
    // 2. REGLAS POR COLECCIÓN
    // -----------------------------------------------------------------------

    // A) CONFIGURACIÓN DEL SISTEMA (Avisos Globales Pop-Up)
    match /system_config/{docId} {
      allow read: if true; // Todos pueden leer la config
      allow write: if isAdmin(); // BLOQUEO: Solo los admins pueden modificar
    }

    // B) CLIENTES (Base de datos de accesos)
    match /clients/{document=**} {
      allow read: if true; // ABIERTO: Para que el portal valide el correo del cliente sin estar logueado
      allow create, delete: if isAdmin(); // BLOQUEO: Nadie más puede agregar o borrar clientes
      
      // MAGIA: El Admin puede actualizar todo. El cliente anónimo SOLO puede tocar el 'contactPin'.
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactPin']);
    }

    // C) TRABAJOS, GASTOS Y VEHÍCULOS
    match /transport_jobs/{jobId} {
      allow read: if true; // ABIERTO: El cliente debe poder leer sus trabajos para ver el GPS
      allow create: if isLogged(); // Solo conductores/admin pueden crear
      allow delete: if isAdmin(); // Nadie puede borrar un trabajo excepto tú
      
      // MAGIA: El equipo interno actualiza todo. El cliente anónimo SOLO puede actualizar el 'checklist' (para poder firmar).
      allow update: if isLogged() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklist']);
    }

    match /expenses/{expId} {
      allow read, create, update: if isLogged();
      allow delete: if isAdmin(); // Bloqueo contra conductores que quieran borrar viáticos asignados
    }
    
    match /vehicles/{vehicleId} {
      allow read: if true; // ABIERTO: El portal de clientes necesita leer datos del vehículo
      allow create, update: if isLogged();
      allow delete: if isAdmin();
    }

    // CATÁLOGO DE MARCAS Y MODELOS (Para selector en traslados, cotizaciones y flota)
    match /vehicle_models/{modelId} {
      allow read: if true; // ABIERTO: Para autocompletar modelos en cotizaciones, formularios y portal
      allow create, update: if isLogged(); // Choferes y administradores pueden añadir o categorizar modelos
      allow delete: if isLogged(); // Administradores y equipo autorizado pueden depurar catálogo
    }
    
    match /drivers/{driverId} {
      allow read: if true; // ABIERTO: El cliente necesita ver el nombre/foto de quien lleva el auto
      allow create, update: if isLogged();
      allow delete: if isAdmin(); // Nadie puede borrar a un compañero del sistema
    }
    
    match /directory/{document=**} {
      allow read: if true; 
      allow write: if isLogged();
    }
    
    match /prts/{document=**} {
      allow read: if true; 
      allow write: if isLogged();
    }

    // D) BANDEJA DE ENTRADA (INBOX)
    match /inbox/{document=**} {
      allow read, write: if isLogged(); // Permite a los usuarios logueados subir y eliminar sus propios archivos
    }

   // E) ESTADÍSTICAS HISTÓRICAS CONSOLIDADAS
    match /historical_stats/{document=**} {
      allow read: if isLogged(); // Conductores y Admins pueden ver estadísticas
      allow write: if isAdmin(); // SOLO el Admin puede escribir (guardar/modificar la foto estática)
    }

    // F) COTIZACIONES Y PEAJES (NUEVO)
    match /quotes/{document=**} {
      allow read, write: if isLogged();
    }
    
    match /tolls/{document=**} {
      allow read, write: if isLogged();
    }
    
    match /monthly_stats/{document} {
      allow read, write: if true;
    }

  }
}
